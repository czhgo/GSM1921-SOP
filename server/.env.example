# server/.env.example — GSM1921-SOP server 环境变量模板（2026-09-03）
# 复制为 server/.env 或直接注入进程环境。所有变量均有缺省，未配置也可本地演示运行。
# 说明：server 自身不读取 .env 文件（无 dotenv 依赖）；如需文件加载请在启动脚本注入。

# ── 基础运行 ─────────────────────────────────────────────────────
# 服务端口（缺省 3000）
PORT=3000
# SQLite 数据库文件路径（缺省 ./data.db；':memory:' 为内存库，测试用）
DB_PATH=./data.db
# 附件上传目录（缺省 server/uploads；相对路径按进程启动目录解析，目录不存在时启动即建）
# 部署时该目录须可写，并纳入备份（与 data.db 一样——附件物理文件只在这里）
# UPLOAD_DIR=./uploads
# 置 1 时空库不自动播种演示种子（真实部署请开：DISABLE_SEED=1）
# DISABLE_SEED=0
# 置 0 时**前端**「考勤 / 考察 / 待办」三域为空时不再回退注入演示种子（Node 托管形态下由此变量注入
# 前端 `docs/src/config/deploy.js::SEED_FALLBACK`；缺省 / 其它值 ⇒ true＝演示形态）。
# 只管这三域的空表回退，**不替代**上面的 `DISABLE_SEED`（服务端种子关断）。
# SEED_FALLBACK=0

# ── 登录口令（2026-09-03 P1b 运行安全）───────────────────────────
# 统一登录口令（/api/v1/auth/login 校验；缺省 '123456'，与前端演示账号一致）
# LOGIN_PASSWORD=123456
# 置 1 时跳过口令校验，仅凭 personId 登录（内网单机演示/测试套件用；生产勿开）
# DISABLE_PASSWORD_CHECK=0

# ── 站内通知邮件（可选；不配置则邮件通知静默停用）────────────────
# MAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your_account
# SMTP_PASS=your_password
# SMTP_FROM=支部系统 <noreply@example.com>
# SMTP_TLS=true

# ── 党委上报通知 Webhook（可选；不配置则上报通知停用）─────────────
# REPORT_WEBHOOK_URL=
# REPORT_TOKEN=
# REPORT_ADMIN_MAIL=
# REPORT_BASE_URL=http://localhost:3000
# REPORT_INCLUDE_CONTACT=true

# ── 运行形态（2026-09-23 上线安全 · P0-3 / P0-4；**生产部署必设**）──────────
# 置 production ⇒ 生产形态（判定单一源 = server/env.js::isProductionEnv；等价开关 NODE_ENV=production）。
# 生产形态下的三条硬约束（非生产形态＝不设本变量时，行为与改动前一字不变）：
#   ① 未设 LOGIN_PASSWORD ⇒ **启动即拒绝**（进程退出并打印可读原因）——所有账号共用该口令，缺省口令不得上线；
#   ② DISABLE_PASSWORD_CHECK **一律不认**（逃逸门只在本地/演示/测试形态生效）；
#   ③ 空库**默认不播种**演示种子（不必再依赖 DISABLE_SEED=1），启动日志会打印 users 计数与演示账号计数自检。
# APP_ENV=production

# ── 生产上线必设（部署前逐项核对；详见 README-server.md §5.3 / §5.6 与 DEPLOYMENT_GUIDE.md 附录 A.2）──
# 1) APP_ENV=production        生产形态必须显式设置（判定单一源 server/env.js；等价开关 NODE_ENV=production）
# 2) LOGIN_PASSWORD=<强口令>     生产形态必填：不设 ⇒ 启动即拒（退出码 1）；该口令为全站账号共用
# 3) UPLOAD_DIR=<可写目录>       附件物理文件落点，须由 Node 进程可写、并纳入备份
# 4) DB_PATH=<库文件路径>        库文件落点，须纳入备份（用 scripts/backup.mjs，勿手拷，见 server/README.md）
# 5) SEED_FALLBACK=0            关断前端「考勤 / 考察 / 待办」三域演示种子回退
#   并确认：未设 DISABLE_PASSWORD_CHECK（生产形态本就不认）；生产形态空库默认不播种，无需再设 DISABLE_SEED
# 反例提示（**绝不要在生产设置**）：DISABLE_PASSWORD_CHECK=1（仅本地/测试）· LOGIN_PASSWORD=123456（缺省口令不得上线）
