# ════════════════════════════════════════════════════════════════
#  deploy/env.production.example —— **生产环境变量**模板（权威清单见 README-server.md §5.3）
#
#  用法：复制成 /etc/gsm1921.env（systemd 用 EnvironmentFile= 读），或按 deploy/install.ps1
#        生成的 start-server.cmd 逐行 set。
#
#  ⚠ `server/` **自己不读 `.env` 文件**（没有 dotenv 依赖）——变量必须由**进程管理器注入**
#    （systemd EnvironmentFile / 计划任务里的 set / docker -e）。把这个文件放在仓库里当 `.env`
#    是不会生效的。
#  ⚠ **生产必设 5 项**（`.env.example` 同口径）：APP_ENV / LOGIN_PASSWORD / UPLOAD_DIR / DB_PATH / SEED_FALLBACK
#  ⚠ **绝不要在生产设置**：DISABLE_PASSWORD_CHECK=1（逃逸门）· LOGIN_PASSWORD=123456（缺省演示口令）
# ════════════════════════════════════════════════════════════════

# ── 形态与端口 ──
APP_ENV=production          # 生产形态：① 未设 LOGIN_PASSWORD 启动即拒 ② 不认 DISABLE_PASSWORD_CHECK ③ 空库默认不播种
PORT=3000                   # 缺省 3000；改端口记得同步反代 deploy/nginx.sample.conf

# ── 口令（**必改**；全站账号共用这一个口令，系统没有个人密码概念）──
LOGIN_PASSWORD=

# ── 数据落点（**必须可写**，且**必须一并纳入备份**）──
DB_PATH=/opt/gsm1921/server/data.db
UPLOAD_DIR=/opt/gsm1921/server/uploads   # 附件物理文件只在磁盘上：丢库可重建、丢文件不可恢复

# ── 数据形态 ──
SEED_FALLBACK=0             # 关断前端「考勤/考察/待办」三域演示回退（默认 true 只为演示；生产置 0）
# DISABLE_SEED=1            # 生产形态已默认不播种；显式设置仅为在非生产环境里模拟

# ── 邮件通道（可选；实测「不开也完全可用」——系统内通知照常）──
# MAIL_ENABLED=true
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=光华管理学院本科生党支部 <gsm1921@example.edu.cn>
# SMTP_TLS=true             # 465 用 SSL / 587 用 STARTTLS

# ── 上报推送（可选）──
# REPORT_WEBHOOK_URL=
# REPORT_TOKEN=
# REPORT_ADMIN_MAIL=
# REPORT_BASE_URL=

# ── 北大 IAAA 统一身份认证（2026-09-29 批次 271；**未接未通，需计算中心给接口**）──
# 口径（支书 2026-09-29）：IAAA 认人 → 有号则登录 / 无号则自动建号 → 选支部 → 支部确认。
# 链路已实现（`server/routes/iaaa.js`：/api/v1/auth/iaaa/login|callback|bind-branch|pending|…），
# 只需下面四项 + 接口文档即可上线；**本地联调**可只设 `IAAA_MOCK=1`（回调的 token 直接当学号）。
# IAAA_APP_ID=                                  # 计算中心分配的 appID
# IAAA_REDIRECT_URI=https://<你的域名>/api/v1/auth/iaaa/callback   # ⚠ 必须与计算中心登记的回调白名单一致
# IAAA_AUTH_URL=https://iaaa.pku.edu.cn/iaaa/oauth.jsp            # 授权页（缺省即此）
# IAAA_VERIFY_URL=https://iaaa.pku.edu.cn/iaaa/oauthlogin.do      # 用 token 换学号/姓名（缺省即此）
# IAAA_MOCK=1                                   # ⚠ 仅本地联调；生产**不要**设
