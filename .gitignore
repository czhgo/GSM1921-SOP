# Dependencies
node_modules/

# IDE / tool artifacts
.trae/
.vscode/
.superpowers/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Temp / process files
*.tmp

# Server runtime artifacts
server/data.db
server/data.*.db*
server/uploads/
server/debug.log
# 备份产物与巡跑状态（T4：每日备份 → backups/；状态 / 错误日志供健康页与告警读取）
server/backups/
server/.backup-status.json
server/.backup-errors.log
server/.tmp-restore-drill/

# Build output (project uses ESM directly, no bundler needed)
docs/dist

# 本地工具产物（可再生成，不入库）
.trae-html-share-packages/
.worktrees/

# 发布包产物（deploy/package.mjs 的输出）
dist/

# 部署脚本生成物（含口令 ⇒ 绝不入库）
deploy/start-server.cmd
