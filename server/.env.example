# server/.env.example — GSM1921-SOP server 环境变量模板（2026-09-03）
# 复制为 server/.env 或直接注入进程环境。所有变量均有缺省，未配置也可本地演示运行。
# 说明：server 自身不读取 .env 文件（无 dotenv 依赖）；如需文件加载请在启动脚本注入。

# ── 基础运行 ─────────────────────────────────────────────────────
# 服务端口（缺省 3000）
PORT=3000
# SQLite 数据库文件路径（缺省 ./data.db；':memory:' 为内存库，测试用）
DB_PATH=./data.db
# 置 1 时空库不自动播种演示种子（真实部署请开：DISABLE_SEED=1）
# DISABLE_SEED=0

# ── 登录口令（2026-09-03 P1b 运行安全）───────────────────────────
# 统一登录口令（/api/v1/auth/login 校验；缺省 '123456'，与前端演示账号一致）
# LOGIN_PASSWORD=123456
# 置 1 时跳过口令校验，仅凭 personId 登录（内网单机演示/测试套件用；生产勿开）
# DISABLE_PASSWORD_CHECK=0

# ── 站内通知邮件（可选；不配置则邮件通知静默停用）────────────────
# MAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your_account
# SMTP_PASS=your_password
# SMTP_FROM=支部系统 <noreply@example.com>
# SMTP_TLS=true

# ── 党委上报通知 Webhook（可选；不配置则上报通知停用）─────────────
# REPORT_WEBHOOK_URL=
# REPORT_TOKEN=
# REPORT_ADMIN_MAIL=
# REPORT_BASE_URL=http://localhost:3000
# REPORT_INCLUDE_CONTACT=true
